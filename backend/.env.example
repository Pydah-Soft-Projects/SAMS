PORT=3001
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/smas
# Optional HRMS source database for linking system users to active employees.
MONGO_EMPLOYEE_URI=
AI_SERVER_URL=http://localhost:8000
# Required only if Hugging Face Space is Private (read token from HF settings)
HF_TOKEN=
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads
FACE_MATCH_THRESHOLD=0.42
MIN_MATCH_MARGIN=0.05
SEARCH_TOP_K=5
FACE_EMBEDDING_SIZE=512

# Namespace for the face index on the shared AI server.
# Each project sharing the same AI server MUST have a unique value here.
# e.g. FACE_INDEX_NAMESPACE=project-alpha  /  FACE_INDEX_NAMESPACE=project-beta
# Leave as "default" for single-project deployments.
FACE_INDEX_NAMESPACE=default

# AWS S3 (preferred persistent photo storage)
# Bucket: sams-lalitha | Region: ap-south-1
# When S3 is set, it is used instead of Cloudinary.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=sams-lalitha

# Cloudinary (optional fallback if S3 is not configured)
# Get these from cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# System auth
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin123

# Web push (overstay alerts) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
